/* braingent STO — the optional Textual flavour.
 *
 * The layout lives here and nowhere else. The Ink version it replaces computed
 * every panel width by hand (`RAIL = 38`, `main = width - 40`), which is why
 * its cards never quite lined up; here the grid states the proportion once and
 * every card inherits the same border, the same padding and the same gutter.
 *
 * Every colour is a token. `$accent` is whatever `sto ui` › Config is set to,
 * and the ground comes from the same screen, so nothing here names a colour.
 */

Screen {
    background: $background;
}

/* ── chrome: pinned top and bottom, never scrolls ── */

#chrome {
    dock: top;
    height: auto;
    background: $panel;
}

#topbar {
    height: 1;
    padding: 0 1;
    color: $foreground 60%;
}

#tabs {
    height: 1;
    padding: 0 1;
}

/* the active tab is a filled rectangle in the accent, the way `sto ui` draws
 * it — same product, same chip. The rest are quiet and unframed: a box around
 * every tab is six boxes and no answer to which one you are on. */
.tab {
    width: auto;
    height: 1;
    margin-right: 2;
    color: $foreground 50%;
}
.tab.on {
    background: $accent;
    color: $background;
    text-style: bold;
}
.tab:hover {
    color: $accent;
}

/* the status strip sits between the screen and the keys: what is running now,
 * and what the last thing that ran had to say */
#status {
    dock: bottom;
    height: 1;
    padding: 0 1;
    background: $panel;
}

/* a key cap is the key in the accent, not a filled block: reversed, six of them
 * across the foot read as a row of buttons and drown their own labels */
Footer {
    dock: bottom;
    background: $panel;
}
FooterKey {
    background: $panel;
    color: $foreground 60%;
}
FooterKey > .footer-key--key {
    background: $panel;
    color: $accent;
    text-style: bold;
}
FooterKey > .footer-key--description {
    color: $foreground 60%;
}
FooterKey:hover {
    background: $surface;
}
FooterKey:hover > .footer-key--key {
    background: $surface;
    color: $accent;
}

/* ── the wordmark: the mark, beside the name, once ── */

#wordmark {
    height: 4;
    padding: 0 1;
    margin-top: 1;
}

/* ── cards: one definition, so every panel is the same object ── */

.card {
    border: round $foreground 30%;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 0 1;
    height: 1fr;
    background: $surface;
}
.card:focus-within { border: round $accent; }

/* ── home: two columns, two rows, stated once ── */

#home {
    layout: grid;
    grid-size: 2 2;
    grid-columns: 1fr 2fr;
    grid-rows: 1fr 1fr;
    grid-gutter: 1 1;
    padding: 1;
}

/* ── lists: table on the left, what the row holds on the right ── */

.split {
    layout: grid;
    grid-size: 2 1;
    grid-columns: 2fr 1fr;
    grid-gutter: 1 1;
    padding: 1;
}
.split-even {
    layout: grid;
    grid-size: 2 1;
    grid-columns: 1fr 2fr;
    grid-gutter: 1 1;
    padding: 1;
}
.one { padding: 1; }
.one > .card { height: 1fr; }

DataTable, Table {
    height: 1fr;
    background: $surface;
    scrollbar-size-vertical: 1;
}
DataTable > .datatable--header {
    background: $surface;
    color: $foreground 50%;
    text-style: none;
}
DataTable > .datatable--cursor {
    background: $accent;
    color: $background;
}
DataTable > .datatable--hover {
    background: $panel;
}

ListView {
    height: 1fr;
    background: $surface;
}
ListView > ListItem { padding: 0 1; background: $surface; }
ListView > ListItem.--highlight { background: $accent; color: $background; }
ListView:focus > ListItem.--highlight { background: $accent; }

/* ── a reader: one document, scrolled ── */

#reader { padding: 1; }
#reader > .card { height: 1fr; }
VerticalScroll {
    scrollbar-size-vertical: 1;
    scrollbar-background: $panel;
    scrollbar-color: $accent 60%;
    scrollbar-color-hover: $accent;
}
#doc { padding: 0 1; }

/* ── toasts: the library's, in our colours ── */

Toast { background: $panel; }
Toast.-information { border-left: outer $accent; }
Toast.-error { border-left: outer $error; }

/* ── the confirmation: one modal for everything that writes ── */

#confirm-wrap {
    align: center middle;
    width: 100%;
    height: 100%;
    background: $background 70%;
}
#confirm-wrap > .card {
    width: 76;
    max-width: 90%;
    height: auto;
    max-height: 70%;
    background: $surface;
}
#confirm-wrap > .card.danger { border: round $error; border-title-color: $error; }
#confirm-body { padding: 1 0; }
#confirm-keys { padding-top: 1; }

/* ── search: docked, not floating over the rows it is filtering ── */

#search {
    dock: bottom;
    display: none;
    height: 3;
    border: round $accent;
    background: $surface;
}
#search:focus { border: round $accent; }

/* ── narrow: one column, no banner, no side panel ── */

.narrow #home {
    grid-size: 1 4;
    grid-columns: 1fr;
    grid-rows: auto auto auto auto;
}
.narrow .split, .narrow .split-even {
    grid-size: 1 1;
    grid-columns: 1fr;
}
.narrow #wordmark { display: none; }
.narrow #session-detail, .narrow #skill-detail { display: none; }
