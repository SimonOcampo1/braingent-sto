/* braingent STO — the optional Textual flavour.
 *
 * The layout lives here and nowhere else. The Ink version it replaces computed
 * every panel width by hand (`RAIL = 38`, `main = width - 40`), which is why
 * its cards never quite lined up; here the grid states the proportion once and
 * every card inherits the same border, the same padding and the same gutter.
 *
 * Every colour is a token. `$accent` is whatever `sto ui` › Config is set to,
 * and the ground comes from the same screen, so nothing here names a colour.
 */

Screen { background: $background; }

/* Textual 8 lifts a widget off its own ground with `background-tint`, which
 * defaults to `$foreground 5%` on several of its widgets -- so a table sat at
 * #0b0b0b on a screen painted #000000 and "pure black" was black everywhere
 * except under the thing you were reading. The tint is the third tone this
 * design does not have; it is turned off where it is applied.
 */
Screen, .card, DataTable, Table, Input, Search, VerticalScroll, Footer,
FooterKey, Static, Container, TabBar {
    background-tint: $background 0%;
}

/* and a scrollbar is part of the panel it scrolls, not a strip of some other
 * theme laid over it -- the library's default track is its own near-black */
* {
    scrollbar-size-vertical: 1;
    scrollbar-background: $background;
    scrollbar-background-hover: $background;
    scrollbar-background-active: $background;
    scrollbar-color: $foreground 25%;
    scrollbar-color-hover: $foreground 45%;
    scrollbar-color-active: $accent;
    scrollbar-corner-color: $background;
}
/* Textual draws the bar of a scrollbar reversed — a blank cell with the bar's
 * colour as its ink — so on the transparent ground, where that colour is the
 * terminal's own default, the swap painted a strip of the terminal's text
 * colour down the side of the pane. Named ansi colours instead: the bar is a
 * colour the terminal chose, and the track keeps showing through. */
*:ansi {
    scrollbar-color: ansi_bright_black;
    scrollbar-color-hover: ansi_white;
}

/* ── chrome: pinned top and bottom, never scrolls ── */
/*
 * One tone for the whole screen. A bar in `$panel` over a pane in `$background`
 * over a card in `$surface` meant "pure black" was black only in the gaps, and
 * every theme had to be looked at three times. Now nothing paints its own
 * ground and what separates a panel from the screen is its outline.
 */

#chrome {
    dock: top;
    height: auto;
    background: $background;
}

/* the tabs are the navigation of the whole product: centred, one row each,
 * with air above and below. Three-row blocks read as buttons shouting over
 * the screen they lead to. */
#tabs {
    layout: horizontal;
    height: 3;
    width: 100%;
    align-horizontal: center;
    padding: 1 1;
}
.tab {
    width: auto;
    height: 1;
    padding: 0 2;
    margin: 0 1;
    color: $foreground 45%;
    text-style: bold;
}
/* the one you are on is a filled block in the accent -- the same chip `sto ui`
 * draws. The rest are quiet and unframed: a box around every tab is six boxes
 * and no answer to which one you are on. */
.tab.on {
    background: $accent;
    color: $background;
}
.tab:hover { color: $accent; }
.tab.on:hover { color: $background; }
/* on the transparent ground `$background` is the terminal's ink, not its
 * ground: the label of the tab you were on came out white on cyan. `reverse`
 * asks the terminal for the swap instead of guessing the colour it would swap
 * to — the block is the accent and the letters are cut out of it in whatever
 * colour that terminal calls its background. */
.tab.on:ansi, .tab.on:ansi:hover {
    background: transparent;
    color: $accent;
    text-style: bold reverse;
}

/* the two rows above the keys: what is running now and what the last thing
 * that ran had to say, plus the arrow that says the pane goes on below.
 * Docked as one container, because dock is to an edge and three widgets
 * claiming the same edge land on each other. */
#bottom {
    dock: bottom;
    height: auto;
    background: $background;
}
#status {
    height: 1;
    padding: 0 1;
    background: $background;
}

/* a key cap is the key in the accent, not a filled block: reversed, six of them
 * across the foot read as a row of buttons and drown their own labels */
/* not docked: it lives inside `#bottom`, which is the one thing docked to
 * that edge. Left docked it claimed the edge for itself and painted over the
 * status strip sharing it. */
Footer { dock: initial; height: 1; background: $background; }
#reader Footer, ModalScreen Footer { dock: bottom; }
FooterKey { background: $background; color: $foreground 60%; }
FooterKey > .footer-key--key { background: $background; color: $accent; text-style: bold; }
FooterKey > .footer-key--description { color: $foreground 60%; }
FooterKey:hover { background: $panel; }
FooterKey:hover > .footer-key--key { background: $panel; color: $accent; }

/* ── the panes ── */

.home, .split, .three, .two { padding: 1; }
/* the home starts lower than the others: it is a masthead, and a masthead
 * pinned to the first available row is a header, not a title page */
.home { padding: 4 1 1 1; }

/* it is the name of the thing, and it was sitting flush left over a search box
 * like a label for it. `auto` because there are two faces: six rows of
 * `ansi_shadow` where the window can hold them, two of `double_blocky` where
 * it cannot. */
#wordmark { height: auto; width: auto; margin: 1 0 2 0; }

/* the search box is part of the screen, not a thing a key summons */
Search {
    height: 3;
    margin-bottom: 1;
    border: round $foreground 25%;
    border-title-color: $foreground 50%;
    background: $background;
}
Search:focus { border: round $accent; border-title-color: $accent; }

/* ── the home: one column, centred, and no boxes ──
 *
 * Everything on this screen answers one question — what state is your OS in —
 * so there is nothing to tell apart and nothing to frame. What is left is a
 * masthead: the name, the box you type in, the numbers, the gauges.
 */
/* the pane itself scrolls, at every width: the masthead, the counts, the
 * gauges and the standing facts are taller than a short window whether or not
 * that window is also narrow */
.home { layout: vertical; overflow-y: auto; scrollbar-size-vertical: 1; }
#wordmark { width: 100%; text-align: center; }
/* the results take the dashboard's room rather than squeezing beside it */
#results { width: 100%; height: 1fr; display: none; }

/* one wrapper per thing that has to sit in the middle. Textual's `align`
 * positions the group of children, not each of them, so a pane holding one
 * 66-wide box and one full-width panel centres neither. */
#search-wrap, #usage-wrap {
    width: 100%;
    height: auto;
    align-horizontal: center;
}
/* wider than a field, narrower than the screen, and heavier than a panel
 * border: on this screen it is the thing you reach for, and a thin grey box at
 * full width reads as a form you have to fill in. */
#search-wrap > Search {
    width: 68;
    max-width: 100%;
    margin: 0 0 2 0;
    border: round $foreground 25%;
    background: $background;
}
#search-wrap > Search:focus { border: round $accent; }

/* `auto` and not `1fr`: a `1fr` box clips whatever does not fit instead of
 * making the pane taller, and the pane is what scrolls. The foot of the home
 * was laid out one row past the bottom edge of a container that could not
 * scroll, so no key and no mouse could reach it. */
#home-grid { width: 100%; layout: vertical; height: auto; }
#where-body { width: 100%; height: auto; text-align: center; margin-top: 2; }
#stats-body { width: 100%; height: auto; text-align: center; margin-bottom: 2; }
#usage-body { width: auto; height: auto; }

/* Sessions and memories are two lists: the projects, and what one project
 * holds. Side by side while there is room for two lists — under that the rail
 * is too narrow to read a name in and the rows belong to projects nobody has
 * chosen — and one panel at a time below it, which is the same hierarchy
 * walked instead of laid out.
 */
.split { layout: grid; grid-size: 2 2; grid-columns: 2fr 3fr; grid-rows: 3 1fr; grid-gutter: 1 1; }
.split > Search { column-span: 2; margin-bottom: 0; }
.split > .card { height: 1fr; min-height: 6; }
.split DataTable { height: 1fr; max-height: 100%; }
/* tools is three panels: the kinds stay put on the left and the two on the
 * right are what changes as you walk in. The list gets more room than the
 * detail beside it: the list is what you read and the panel next to it is the
 * footnote. */
.split.three-way { grid-size: 3 2; grid-columns: 18 3fr 2fr; }
.split.three-way > Search { column-span: 3; }

/* one panel at a time, at whichever width its own pane says */
.stacked .split.two-way, .narrow .split.three-way { layout: vertical; }
.stacked .split.two-way > Search,
.narrow .split.three-way > Search { width: 100%; margin-bottom: 1; }
.stacked .split.two-way > .card,
.narrow .split.three-way > .card { height: 1fr; min-height: 6; }

.three { layout: grid; grid-size: 2 2; grid-columns: 1fr 1fr; grid-rows: 1fr 1fr; grid-gutter: 1 1; }
#prefs { column-span: 1; }
#remote { column-span: 2; }
.two { layout: grid; grid-size: 2 1; grid-columns: 2fr 1fr; grid-gutter: 1 1; }

/* ── cards: one definition, so every panel is the same object ── */

.card {
    border: round $foreground 25%;
    border-title-color: $foreground 55%;
    border-title-style: bold;
    padding: 0 1;
    height: 1fr;
    background: $background;
}
/* the card that holds the focus says so: a table that is taking your arrow
 * keys and a table that is not have to look different from across the screen */
.card:focus-within {
    border: round $accent;
    border-title-color: $accent;
    background: $background;
}

/* ── tables ── */

DataTable, Table {
    height: 1fr;
    background: $background;
    scrollbar-size-vertical: 1;
    scrollbar-background: $background;
    scrollbar-color: $foreground 30%;
    scrollbar-color-hover: $accent;
}
DataTable > .datatable--header {
    background: $background;
    background-tint: $background 0%;
    color: $foreground 50%;
    text-style: none;
}
/* The cursor is a tint of the accent, never a slab of it.
 *
 * A cell carries its own colours — a button outline, an error count in red, a
 * machine name in the accent — and every one of those was picked to be legible
 * on the ground. Replacing the ground with solid accent and forcing the text
 * to `$background` made a button's grey label black-on-cyan and its outline
 * invisible: markup that sets a colour ignores the cursor's, and markup that
 * does not gets a colour chosen for a different background. A tint leaves the
 * ground recognisably the ground, so every cell in the row stays as legible as
 * it was — whatever the accent happens to be.
 *
 * The row still goes monochrome — `DataTable` applies the cursor's foreground
 * over the cell's own spans and it carries one by default, so there is no way
 * to keep a span's colour under a cursor. Every table does that. What must not
 * change is the *direction*: the screen is light text on a dark ground, and
 * one row of dark text on a bright ground is the row you were looking at
 * turning into a different design. That is why it is a tint and not a slab.
 *
 * Bright only where the keys are going; elsewhere it is a remembered place,
 * not an active one. */
DataTable > .datatable--cursor { background: $accent 12%; color: $foreground; }
DataTable:focus > .datatable--cursor {
    background: $accent 35%;
    color: $foreground;
    text-style: bold;
}
DataTable > .datatable--hover { background: $accent 8%; }

/* except on the transparent ground, where there is nothing to tint: a colour
 * with alpha over `ansi_default` is blended against black, and the row you
 * selected comes out a grey-green band on a terminal that was meant to show
 * through. There the cursor is ink and no paint at all — which reads, because
 * `DataTable` puts the cursor's foreground over the cell's own spans anyway. */
DataTable:ansi > .datatable--cursor { background: transparent; color: $accent 60%; }
DataTable:ansi:focus > .datatable--cursor {
    background: transparent;
    color: $accent;
    text-style: bold;
}
DataTable:ansi > .datatable--hover { background: transparent; }

/* ── a reader: one document, scrolled ── */

/* A stack and not a grid. The grid put the document in a `1fr` row and the
 * neighbours in an `auto` one, and a `1fr` card inside an `auto` row resolves
 * to its own natural height: the strip took the screen and the document was
 * laid out at zero. A memory opened blank with only its links, and `enter` on
 * one of those opened another blank memory -- which is what read as a loop.
 * Sessions and skills were never affected because they have no neighbours and
 * the strip is never composed at all. */
#reader { padding: 1; layout: vertical; }
#reader > .card { height: 1fr; margin-bottom: 1; }
/* The neighbours are a fixed strip under the document, not half the screen.
 *
 * At least as specific as `#reader > .card` above -- an id plus a class beats
 * a bare `#links`, so without this the strip also asks for `1fr`, and a `1fr`
 * inside an `auto` grid row resolves to its own natural height. The strip took
 * the screen and the document was laid out at zero: a memory opened blank with
 * only its links, and `enter` on one of those opened another blank memory,
 * which is what read as a loop. Sessions and skills were fine because they
 * have no neighbours and the strip is never composed. */
#reader #links { height: 10; }
VerticalScroll {
    scrollbar-size-vertical: 1;
    scrollbar-background: $background;
    scrollbar-color: $foreground 30%;
    scrollbar-color-hover: $accent;
}
#doc { padding: 0 1; }

/* ── the confirmation: one modal for everything that writes ── */

#confirm-wrap {
    align: center middle;
    width: 100%;
    height: 100%;
    background: $background 70%;
}
#confirm-wrap > .card {
    width: 76;
    max-width: 90%;
    height: auto;
    max-height: 70%;
    background: $background;
    border: round $accent;
    border-title-color: $accent;
}
#confirm-wrap > .card.danger { border: round $error; border-title-color: $error; }
#confirm-body { padding: 1 0; }
#confirm-keys { padding-top: 1; }

/* ── toasts: the library's, in our colours ── */

Toast { background: $panel; }
Toast.-information { border-left: outer $accent; }
Toast.-error { border-left: outer $error; }

/* ── narrow: one column ──
 *
 * The cards stop being `1fr` here, and that is the whole fix. In the wide grid
 * every card sits in a `1fr` row and they share the height; the narrow grid has
 * `auto` rows, and a `1fr` card inside an `auto` row resolves to its full
 * natural height — for a table of forty-three sessions, several screens. The
 * first card took everything and the rest were laid out past the bottom edge of
 * a pane that could not scroll, so no key and no mouse could reach them.
 */

/* `height: auto` and not `1fr`: the grid is a child of the pane, and a `1fr`
 * child is clipped to the pane instead of making it taller. The scroll then
 * belongs to the grid, which has no scrollbar and no keys pointed at it, so
 * the cards past the fold are cut off exactly as before. */
.narrow #home-grid { height: auto; }
.narrow #usage-body { height: auto; }
/* the masthead breathes where there is room and stops breathing where there is
 * not: four blank rows spent on air is one gauge pushed under the fold */
.narrow #wordmark { margin: 0 0 1 0; }
.narrow .home { padding: 1 1 1 1; }
.narrow #search-wrap > Search { margin-bottom: 1; }
.narrow #stats-body { margin-bottom: 1; }
.narrow .three { grid-size: 1 3; grid-columns: 1fr; grid-rows: auto auto auto; }
.narrow #prefs, .narrow #remote { column-span: 1; }
.narrow .two { grid-size: 1 2; grid-columns: 1fr; grid-rows: auto auto; }

.narrow .card { height: auto; min-height: 6; }
/* without a ceiling one card is taller than three screens and the stack stops
 * being something you can scan. Both numbers are tuned against a rendered
 * screen, not derived: six is a heading and three rows, fourteen is about a
 * screenful. */
.narrow .card DataTable { height: auto; max-height: 14; }
.narrow .card VerticalScroll { height: auto; max-height: 14; }

/* A split showing one panel at a time gives it the screen -- there is nothing
 * under it to leave room for. So these keep `1fr` while the stacking panes go
 * to `auto`, and they scroll inside the table the way they always did rather
 * than scrolling the pane.
 *
 * `height: auto` on a `DataTable` is not the answer here: it measures to one
 * row and the list disappears under its own header.
 *
 * And not a grid: a grid keeps a row for a panel that is hidden, so the one
 * panel on screen inherited the three rows reserved for the search box and
 * vanished under its own header. A vertical stack only lays out what is
 * displayed. Both live in the block above, next to the breakpoint they answer. */
.narrow .split DataTable { height: 1fr; max-height: 100%; }
.narrow .split VerticalScroll { height: 1fr; max-height: 100%; }

/* the pane itself is what scrolls: no extra container, so the widget tree is
 * the same at every width and a resize moves nothing */
.narrow .three, .narrow .two {
    overflow-y: auto;
    scrollbar-size-vertical: 1;
}

/* one row that says the pane goes on below, and stops saying it at the bottom.
 * Only down: the scrollbar already shows there is something above, and a second
 * indicator for a fact already on screen is noise. */
#more {
    height: 1;
    text-align: center;
    color: $accent;
    background: $panel;
    display: none;
}
#more:hover { background: $panel; }

/* ── a transcript, as the conversation it was ── */

.blk { width: 100%; height: auto; }
.blk.meta  { color: $foreground 50%; margin-bottom: 1; }
.blk.who   { text-style: bold; margin-top: 1; padding-left: 1; }
.blk.user  { padding-left: 2; border-left: outer $accent; }
.blk.claude{ padding-left: 2; border-left: outer $success; }
.blk.who.user   { color: $accent; border-left: none; padding-left: 1; }
.blk.who.claude { color: $success; border-left: none; padding-left: 1; }
.blk.code {
    background: $panel;
    color: $secondary;
    padding: 0 2;
    margin: 1 0;
    border-left: outer $foreground 30%;
}
.blk.tool { color: $foreground 50%; padding-left: 2; }
.blk.bad  { color: $error; padding-left: 2; }
.blk.plain { padding: 0 1; }

/* ── the wordmark answers for its own size ──
 *
 * Which of its three sizes is on screen is decided in `on_resize`, because it
 * is a choice of *content* and CSS cannot swap the art. What is left here is
 * the last step: on a terminal too short to spare six rows, a banner costs
 * most of the usable height to say what the screen already says. */

.short #wordmark { display: none; }

/* A verb belongs to the tab that can do it. Textual dims a key its
   `check_action` turned off; dimming still spends footer width on `delete
   here` over a screen with nothing to delete, so it goes instead. */
Footer FooterKey.-disabled {
    display: none;
}

/* ── where a project lives on this machine ── */

#path-input {
    margin-top: 1;
    border: round $foreground 30%;
    background: $panel;
}
#path-input:focus { border: round $accent; }
